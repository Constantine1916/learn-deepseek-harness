{
  "name": "@learn-dsh/learner-memory",
  "version": "0.1.0",
  "description": "Append-only durable learner event memory Service and local provider for Learn DSH.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine1916/learn-deepseek-harness.git",
    "directory": "packages/learner-memory"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./local": {
      "types": "./lib/local.d.ts",
      "default": "./lib/local.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1"
  }
}
