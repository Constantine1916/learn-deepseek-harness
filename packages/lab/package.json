    "@deepseek-ai/dsh-shell": "0.1.0-rc.5",
    "@learn-dsh/curriculum": "0.1.0",
    "@learn-dsh/learner": "0.1.0",
    "@learn-dsh/learner-memory": "0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
