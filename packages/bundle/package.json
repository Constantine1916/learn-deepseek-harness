{
  "name": "@learn-dsh/bundle",
  "version": "0.1.0",
  "description": "Installable Learn DSH profile patch layer for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine1916/learn-deepseek-harness.git",
    "directory": "packages/bundle"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "learn-dsh-setup": "lib/setup-bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./setup": {
      "types": "./lib/setup.d.ts",
      "default": "./lib/setup.js"
    },
    "./presets/learn-dsh/agent.cordis.yml": "./presets/learn-dsh/agent.cordis.yml",
    "./presets/learn-dsh/preset.yml": "./presets/learn-dsh/preset.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "presets/**/*.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@learn-dsh/curriculum": "workspace:^",
    "@learn-dsh/lab": "workspace:^",
    "@learn-dsh/learner": "workspace:^",
    "@learn-dsh/learner-memory": "workspace:^",
    "@learn-dsh/teacher": "workspace:^",
    "@learn-dsh/teaching": "workspace:^",
    "@learn-dsh/tool-learning": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1"
  }
}
